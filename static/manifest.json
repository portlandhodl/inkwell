{
  "manifest_version": 3,
  "name": "Inkwell — Markdown Editor",
  "short_name": "Inkwell",
  "version": "1.0.0",
  "description": "A beautiful, fast Markdown editor powered by Rust + WebAssembly. Live preview, math, diagrams, themes, import & export.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Inkwell",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "contextMenus",
    "storage",
    "unlimitedStorage"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Open Inkwell"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "optional_host_permissions": [
    "<all_urls>"
  ]
}